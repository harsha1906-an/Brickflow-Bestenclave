doctype html
html
  head
    link(rel="shortcut icon" type="image/png" href="/images/icons/favicon.png")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    link(href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;700&display=swap" rel="stylesheet")
    style.
      .sheet { margin: 0; width: 100%; height: 297mm; }
      body { width: 100%; margin: 0; padding: 20px; background: #ffffff; font-family: 'Noto Sans', sans-serif; font-size:12px; color:#222; }
      *, *:before, *:after { box-sizing: inherit; color:#222; }
      .clearfix { display: block; }
      .left { float:left; }
      .right { float:right; }
      .header-section { margin-bottom: 20px; border-bottom: 1px solid #eee; padding-bottom: 10px; }
      .report-title { font-size: 24px; color: #333; margin: 0; font-weight: normal; }
      .criteria-section { background: #f0f0f0; border: 1px solid #ddd; padding: 10px; margin-bottom: 20px; border-radius: 4px; }
      .table-report { width: 100%; border-collapse: collapse; border-spacing: 0; margin-bottom: 20px; }
      .table-report th { background: #0088cc; color: #ffffff; padding: 10px; font-weight: bold; font-size: 12px; text-align: left; border: 1px solid #0077b3; }
      .table-report th.text-right { text-align: right; }
      .table-report td { padding: 8px 10px; text-align: left; font-size: 11px; border: 1px solid #ddd; color: #333; }
      .table-report td.text-right { text-align: right; }
      .table-report tr:nth-child(even) td { background: #f9f9f9; }
      .footer-report { margin-top:30px; color: #5d6975; width: 100%; text-align: center; font-size: 10px; }
      .tag { padding: 4px 8px; border-radius: 4px; font-size: 10px; font-weight: bold; }
      .tag-green { color: #389e0d; font-weight: bold; }
      .tag-red { color: #cf1322; font-weight: bold; }

  body
    header.header-section.clearfix
      .left
        h1.report-title Customer Summary
        a(href="#" style="font-size: 12px; color: #0088cc; text-decoration: none;") << Back to Reports
      .right
        if logo
          img.logo(src=logo style="max-height: 75px;")
        else if settings.company_logo
          img.logo(src=settings.public_server_file+settings.company_logo style="max-height: 75px;")
        if settings.company_gstin
          div(style="font-size: 10px; margin-top: 5px; text-align: right;") GSTIN: #{settings.company_gstin}

    .criteria-section
        strong Report Criteria
        div(style="margin-top: 5px;")
            span Date Range: 
            strong All Time
    
    .section-title(style="margin-bottom: 10px; font-weight: bold;") Customer Summary

    main
      table.table-report
        thead
          tr
            th Date
            th Name & Phone
            th Booked Villa
            th.text-right Total Value
            th.text-right Total Paid
            th.text-right Balance Due
        tbody
          each client in model.clients
            tr
              td #{moment(client.created).format(dateFormat)}
              td 
                div(style="font-weight:bold") #{client.name}
                div(style="font-size:9px; color:#666") #{client.phone || ''}
              td #{client.villaNumber ? client.villaNumber : '-'}
              td.text-right #{moneyFormatter({amount: client.totalValue || 0})}
              td.text-right.tag-green #{moneyFormatter({amount: client.totalPaid || 0})}
              td.text-right.tag-red #{moneyFormatter({amount: client.balance || 0})}
          tr(style="background-color: #e6f7ff; font-weight: bold; border-top: 2px solid #0088cc;")
            td(colspan="3") GRAND TOTAL
            td.text-right #{moneyFormatter({amount: model.totals.totalValue})}
            td.text-right(style="color: #389e0d;") #{moneyFormatter({amount: model.totals.totalPaid})}
            td.text-right(style="color: #cf1322;") #{moneyFormatter({amount: model.totals.balance})}

    footer.footer-report
      | Report generated by #{settings.company_name} on #{moment().format('MMMM Do YYYY, h:mm:ss a')}
