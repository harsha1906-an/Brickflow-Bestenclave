doctype html
html
  head
    link(href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;600;700&display=swap" rel="stylesheet")
    style.
      @page {
        size: A4 landscape;
        margin: 10mm 12mm;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        font-family: 'Noto Sans', 'Helvetica Neue', Helvetica, Arial, sans-serif;
        color: #222;
        font-size: 10px;
        line-height: 1.4;
        background: #fff;
      }

      /* ─── HEADER ─────────────────────────────────────── */
      .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        border-bottom: 3px solid #1565c0;
        padding-bottom: 8px;
        margin-bottom: 12px;
      }
      .company-block { flex: 1; }
      .report-title {
        font-size: 18px;
        font-weight: 700;
        color: #1565c0;
        letter-spacing: 0.5px;
      }
      .company-name { font-size: 12px; font-weight: 600; color: #333; margin-top: 3px; }
      .company-meta { font-size: 9px; color: #666; margin-top: 2px; }
      .report-meta { text-align: right; font-size: 9px; color: #555; }
      .report-meta .period {
        font-size: 11px; font-weight: 700; color: #1565c0; margin-bottom: 4px;
      }

      /* ─── SUMMARY CARDS ──────────────────────────────── */
      .summary-row {
        display: flex;
        gap: 8px;
        margin-bottom: 12px;
      }
      .summary-card {
        flex: 1;
        border-radius: 6px;
        padding: 8px 10px;
        border: 1px solid #ddd;
      }
      .card-income  { background: #e8f5e9; border-color: #a5d6a7; }
      .card-expense { background: #fce4ec; border-color: #f48fb1; }
      .card-profit  { background: #e3f2fd; border-color: #90caf9; }
      .card-tax     { background: #fff8e1; border-color: #ffe082; }
      .card-label { font-size: 9px; color: #666; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; }
      .card-amount { font-size: 15px; font-weight: 700; margin-top: 2px; }
      .card-income  .card-amount { color: #2e7d32; }
      .card-expense .card-amount { color: #c62828; }
      .card-profit  .card-amount { color: #1565c0; }
      .card-tax     .card-amount { color: #f57f17; }
      .card-sub { font-size: 8.5px; color: #888; margin-top: 2px; }

      /* ─── SECTION TITLES ─────────────────────────────── */
      .section-title {
        font-size: 11px;
        font-weight: 700;
        color: #fff;
        background: #1565c0;
        padding: 5px 10px;
        border-radius: 4px 4px 0 0;
        margin-top: 10px;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .section-title.expense-title { background: #b71c1c; }
      .section-title.gst-title     { background: #4527a0; }

      /* ─── TABLES ─────────────────────────────────────── */
      table {
        width: 100%;
        border-collapse: collapse;
        font-size: 9.5px;
        margin-bottom: 4px;
      }
      thead th {
        background: #e3f2fd;
        color: #1565c0;
        font-weight: 700;
        padding: 5px 6px;
        border: 1px solid #bbdefb;
        text-align: left;
        white-space: nowrap;
      }
      .expense-section thead th {
        background: #fce4ec;
        color: #b71c1c;
        border-color: #f8bbd0;
      }
      .gst-section thead th {
        background: #ede7f6;
        color: #4527a0;
        border-color: #d1c4e9;
      }
      tbody td {
        padding: 4px 6px;
        border: 1px solid #e8e8e8;
        vertical-align: top;
      }
      tbody tr:nth-child(even) { background: #fafafa; }
      tbody tr:hover           { background: #f0f4ff; }
      .total-row td {
        background: #e3f2fd !important;
        font-weight: 700;
        color: #1565c0;
        border-top: 2px solid #90caf9;
        font-size: 10px;
      }
      .expense-section .total-row td {
        background: #fce4ec !important;
        color: #b71c1c;
        border-top-color: #f48fb1;
      }
      .gst-section .total-row td {
        background: #ede7f6 !important;
        color: #4527a0;
        border-top-color: #ce93d8;
      }

      /* ─── HELPERS ────────────────────────────────────── */
      .text-right  { text-align: right; }
      .text-center { text-align: center; }
      .mono        { font-family: 'Courier New', monospace; font-weight: 600; }
      .color-green { color: #2e7d32; }
      .color-red   { color: #c62828; }
      .color-orange{ color: #e65100; }
      .tag {
        display: inline-block;
        padding: 1px 5px;
        border-radius: 3px;
        font-size: 8.5px;
        font-weight: 600;
      }
      .tag-official { background: #e8f5e9; color: #2e7d32; border: 1px solid #a5d6a7; }
      .tag-internal { background: #fff3e0; color: #e65100; border: 1px solid #ffe0b2; }
      .tag-igst     { background: #ede7f6; color: #4527a0; border: 1px solid #ce93d8; }
      .tag-cgst     { background: #e3f2fd; color: #1565c0; border: 1px solid #90caf9; }
      .tag-none     { background: #f5f5f5; color: #9e9e9e; border: 1px solid #e0e0e0; }

      /* ─── FOOTER ─────────────────────────────────────── */
      .page-footer {
        position: fixed;
        bottom: 4mm;
        left: 12mm;
        right: 12mm;
        border-top: 1px solid #ccc;
        padding-top: 4px;
        display: flex;
        justify-content: space-between;
        font-size: 8.5px;
        color: #999;
      }

      /* ─── PAGE BREAK ─────────────────────────────────── */
      .page-break { page-break-before: always; }

  body
    //- ── HEADER ────────────────────────────────────────────────
    .page-header
      .company-block
        .report-title Taxation &amp; Financial Report
        .company-name #{settings.company_name || 'Company'}
        .company-meta
          if settings.company_address
            div #{settings.company_address}
          div
            if settings.company_gstin
              span GSTIN: #{settings.company_gstin}
            if settings.company_phone
              span  |  Phone: #{settings.company_phone}
            if settings.company_email
              span  |  Email: #{settings.company_email}
      .report-meta
        if model.startDate && model.endDate
          .period Period: #{model.startDate} — #{model.endDate}
        else
          .period All Transactions
        div Generated: #{moment().format('DD/MM/YYYY HH:mm')}
        div #{settings.company_name}

    //- ── SUMMARY CARDS ──────────────────────────────────────────
    .summary-row
      .summary-card.card-income
        .card-label Total Income (Base)
        .card-amount.mono #{moneyFormatter({ amount: model.totalIncome || 0 })}
        .card-sub #{model.incomeRows ? model.incomeRows.length : 0} payment(s) received
      .summary-card.card-expense
        .card-label Total Expenses (Base)
        .card-amount.mono #{moneyFormatter({ amount: model.totalExpense || 0 })}
        .card-sub #{model.expenseRows ? model.expenseRows.length : 0} expense(s) recorded
      .summary-card.card-profit
        .card-label Net Profit / Loss
        - var np = (model.netProfit || 0)
        .card-amount.mono(class=np >= 0 ? 'color-green' : 'color-red') #{moneyFormatter({ amount: np })}
        .card-sub Income minus Expenses
      .summary-card.card-tax
        .card-label Total GST Collected
        .card-amount.mono.color-orange #{moneyFormatter({ amount: model.totalIncomeTax || 0 })}
        .card-sub Payable: #{moneyFormatter({ amount: model.netTaxBalance || 0 })}

    //- ── INCOME SECTION ─────────────────────────────────────────
    if model.incomeRows && model.incomeRows.length > 0
      .section-title
        span ▲ INCOME — Customer Payments (#{model.incomeRows.length} Records)
        span Total: #{moneyFormatter({ amount: model.totalIncome || 0 })}

      table
        thead
          tr
            th(style="width:4%") #
            th(style="width:8%") Date
            th(style="width:7%") Ref
            th(style="width:20%") Client Name
            th(style="width:22%") Description
            th(style="width:8%") Mode
            th(style="width:8%; text-align:right") Base Amt
            th(style="width:5%; text-align:center") Tax %
            th(style="width:7%; text-align:right") Tax Amt
            th(style="width:3%; text-align:center") Type
            th(style="width:8%; text-align:right") Total
        tbody
          - var tBase = 0, tTax = 0, tTotal = 0
          each row, i in model.incomeRows
            - tBase  += (row.baseAmount  || 0)
            - tTax   += (row.taxAmount   || 0)
            - tTotal += (row.totalAmount || 0)
            tr
              td.text-center #{i + 1}
              td #{row.dateStr}
              td.mono #{row.ref}
              td #{row.entity}
              td #{row.description}
              td #{row.paymentMode}
              td.text-right.mono.color-green #{moneyFormatter({ amount: row.baseAmount || 0 })}
              td.text-center
                if (row.taxRate || 0) > 0
                  | #{row.taxRate}%
                else
                  | —
              td.text-right.mono.color-orange
                if (row.taxAmount || 0) > 0
                  | #{moneyFormatter({ amount: row.taxAmount })}
                else
                  | —
              td.text-center
                if row.taxType === 'IGST'
                  span.tag.tag-igst IGST
                else if row.taxType === 'CGST_SGST'
                  span.tag.tag-cgst CGST
                else
                  span.tag.tag-none NIL
              td.text-right.mono #{moneyFormatter({ amount: row.totalAmount || 0 })}
          tr.total-row
            td(colspan="6", style="text-align:right; font-weight:700;") INCOME TOTALS →
            td.text-right.mono #{moneyFormatter({ amount: tBase })}
            td
            td.text-right.mono #{moneyFormatter({ amount: tTax })}
            td
            td.text-right.mono #{moneyFormatter({ amount: tTotal })}
    else
      p(style="color:#999; font-style:italic; margin:8px 0;") No income records for this period.

    //- ── EXPENSE SECTION ────────────────────────────────────────
    .page-break
    .section-title.expense-title
      span ▼ EXPENSES — Supplier &amp; Labour Payments (#{model.expenseRows ? model.expenseRows.length : 0} Records)
      span Total: #{moneyFormatter({ amount: model.totalExpense || 0 })}

    .expense-section
      if model.expenseRows && model.expenseRows.length > 0
        table
          thead
            tr
              th(style="width:4%") #
              th(style="width:8%") Date
              th(style="width:7%") Ref
              th(style="width:18%") Recipient
              th(style="width:7%") Category
              th(style="width:15%") Description
              th(style="width:7%") Mode
              th(style="width:8%; text-align:right") Base Amt
              th(style="width:5%; text-align:center") Tax %
              th(style="width:7%; text-align:right") Tax Amt
              th(style="width:3%; text-align:center") Type
              th(style="width:8%; text-align:right") Total
          tbody
            - var eBase = 0, eTax = 0, eTotal = 0
            each row, i in model.expenseRows
              - eBase  += (row.baseAmount  || 0)
              - eTax   += (row.taxAmount   || 0)
              - eTotal += (row.totalAmount || 0)
              tr
                td.text-center #{i + 1}
                td #{row.dateStr}
                td.mono #{row.ref}
                td #{row.entity}
                td #{row.recipientType}
                td #{row.description}
                td #{row.paymentMode}
                td.text-right.mono.color-red #{moneyFormatter({ amount: row.baseAmount || 0 })}
                td.text-center
                  if (row.taxRate || 0) > 0
                    | #{row.taxRate}%
                  else
                    | —
                td.text-right.mono.color-orange
                  if (row.taxAmount || 0) > 0
                    | #{moneyFormatter({ amount: row.taxAmount })}
                  else
                    | —
                td.text-center
                  if row.taxType === 'IGST'
                    span.tag.tag-igst IGST
                  else if row.taxType === 'CGST_SGST'
                    span.tag.tag-cgst CGST
                  else
                    span.tag.tag-none NIL
                td.text-right.mono #{moneyFormatter({ amount: row.totalAmount || 0 })}
            tr.total-row
              td(colspan="7", style="text-align:right; font-weight:700;") EXPENSE TOTALS →
              td.text-right.mono #{moneyFormatter({ amount: eBase })}
              td
              td.text-right.mono #{moneyFormatter({ amount: eTax })}
              td
              td.text-right.mono #{moneyFormatter({ amount: eTotal })}
      else
        p(style="color:#999; font-style:italic; margin:8px 0;") No expense records for this period.

    //- ── GST / TAX SUMMARY ──────────────────────────────────────
    .section-title.gst-title(style="margin-top: 14px;")
      span ◆ GST &amp; TAX SUMMARY
      span Period: #{model.startDate || 'All'} — #{model.endDate || 'All'}

    .gst-section
      table(style="width: 100%;")
        thead
          tr
            th(style="width: 40%") Category
            th.text-right(style="width: 20%") Amount (Base)
            th.text-right(style="width: 20%") GST / Tax
            th.text-right(style="width: 20%") Total (with Tax)
        tbody
          tr
            td(style="font-weight:600; color: #2e7d32;") ▲ Total Income (Customer Payments)
            td.text-right.mono.color-green #{moneyFormatter({ amount: model.totalIncome || 0 })}
            td.text-right.mono.color-orange #{moneyFormatter({ amount: model.totalIncomeTax || 0 })}
            td.text-right.mono #{moneyFormatter({ amount: (model.totalIncome || 0) + (model.totalIncomeTax || 0) })}
          tr
            td(style="font-weight:600; color: #c62828;") ▼ Total Expenses (Supplier + Labour)
            td.text-right.mono.color-red #{moneyFormatter({ amount: model.totalExpense || 0 })}
            td.text-right.mono.color-orange #{moneyFormatter({ amount: model.totalExpenseTax || 0 })}
            td.text-right.mono #{moneyFormatter({ amount: (model.totalExpense || 0) + (model.totalExpenseTax || 0) })}
          tr.total-row.gst-section
            td(style="font-weight:700; font-size:11px;") NET PROFIT / LOSS
            - var np = (model.netProfit || 0)
            td.text-right.mono(style=np >= 0 ? 'color: #2e7d32; font-size:11px;' : 'color: #c62828; font-size:11px;') #{moneyFormatter({ amount: np })}
            - var ntb = (model.netTaxBalance || 0)
            td.text-right.mono(style="font-size:11px; color: #f57f17;") #{moneyFormatter({ amount: ntb })}
            td.text-right.mono(style="font-size:11px;") #{moneyFormatter({ amount: np + ntb })}

    .page-footer
      span #{settings.company_name} — Taxation &amp; Financial Report
      if model.startDate && model.endDate
        span Period: #{model.startDate} to #{model.endDate}
      else
        span All Transactions
      span Generated: #{moment().format('DD/MM/YYYY HH:mm')}
