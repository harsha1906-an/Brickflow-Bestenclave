doctype html
html
  head
    meta(name="viewport" content="width=device-width, initial-scale=1")
    link(href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;700&display=swap" rel="stylesheet")
    style.
      @page {
        size: A4 portrait;
        margin: 15mm 20mm;
      }
      body { margin: 0; padding: 0px; background: #ffffff; font-family: 'Noto Sans', sans-serif; font-size:12px; color:#222; }
      *, *:before, *:after { box-sizing: border-box; color:#222; }
      .clearfix { display: block; }
      .clearfix::after { content: ""; clear: both; display: table; }
      .left { float:left; }
      .right { float:right; }
      .top-area { display: block; width:100%; }
      .logo { max-width: 338px; max-height: 135px; object-fit: contain; }
      .company-info { text-align: right; font-size:11px; line-height: 1.4; }
      .company-info p { margin: 2px 0; }
      h1.report-title { font-size:22px; color:#52008c; margin-top:0; margin-bottom: 15px; }
      .table-report { width: 100%; border-collapse: collapse; border-spacing: 0; margin-bottom: 20px; border: 1px solid #c2e0f2; }
      .table-report tr:nth-child(2n-1) td { background: #fcfeff; }
      .table-report th { padding: 8px 10px; border: 1px solid #c2e0f2; color:#52008c; font-weight: 700; font-size: 11px; text-align: left; background: #f0f7ff; }
      .table-report td { padding: 8px 10px; border: 1px solid #e8e8e8; text-align: left; font-size: 10px; }
      .footer-report { margin-top:30px; color: #888; width: 100%; text-align: center; font-size: 10px; border-top: 1px solid #eee; padding-top: 15px; }

  body
    header.clearfix
      .top-area
        if logo
          img.logo.left(src=logo)
        else if settings.company_logo
          img.logo.left(src=settings.public_server_file+settings.company_logo)
        .right.company-info
          p.strong #{settings.company_name}
          p #{settings.company_address}
          if settings.company_gstin
            p GSTIN: #{settings.company_gstin}
          p #{settings.company_reg_number}
      
      .clearfix(style="margin-top: 20px; margin-bottom: 20px;")
        h1.report-title Inventory Report
        p
          strong Date Range: 
          | #{moment(model.startDate).format(dateFormat)} - #{moment(model.endDate).format(dateFormat)}
        if model.villa
          p
            strong Villa: 
            | #{model.villa.villaNumber}
        else
            p
            strong Villa: 
            | All Villas

    main
      table.table-report
        thead
          tr
            th Date
            th Material
            th Type
            th Villa
            th Quantity
            th Ref/Notes
        tbody
          each item in model.items
            tr
              td #{moment(item.date).format(dateFormat)}
              td #{item.material ? item.material.name : '-'}
              td #{item.type == 'inward' ? 'IN' : 'OUT'}
              td #{item.villa ? 'Villa ' + item.villa.villaNumber : 'Global'}
              td #{item.quantity} #{item.material ? item.material.unit : ''}
              td #{item.reference}

    footer.footer-report
      | Report generated on #{moment().format(dateFormat)}
